<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet for Supabase -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Read the phone book so "📱 Chọn Từ Danh Bạ" can import suppliers -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>

    <!--
        NOTE for Android 13+ (API 33+): the system shows its own runtime
        dialog; READ_CONTACTS is a "dangerous" permission so the app asks
        at runtime via permission_handler. Nothing else is required here.
    -->

    <application
        android:label="Quản Lý Rau"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initialises. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Don't delete the meta-data below. This is used by the Flutter tool
             to generate GeneratedPluginRegistrant. -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
